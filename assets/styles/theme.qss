}

/* ==========================================
   WORKSPACE BUILDER FIGMA SHELL
   ========================================== */

QWidget#WorkspacesPage {
    background-color: #FFFFFF;
}

QFrame#WorkspaceTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QLabel#WorkspacePageTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#WorkspacePageSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QSplitter#WorkspaceBuilderSplitter {
    background-color: #FFFFFF;
}

QSplitter#WorkspaceLeftPanelSplitter {
    background-color: transparent;
}

QSplitter#WorkspaceLeftPanelSplitter::handle:vertical {
    background-color: transparent;
    height: 14px;
    margin: 2px 64px;
    border-top: 2px solid #DADADF;
    border-bottom: 2px solid transparent;
}

QSplitter#WorkspaceLeftPanelSplitter::handle:vertical:hover {
    border-top-color: #A1A1AA;
}

QSplitter#WorkspaceLeftPanelSplitter::handle:vertical:pressed {
    border-top-color: #0891B2;
}

QFrame#WorkspaceLeftRail,
QFrame#WorkspaceInspector,
QFrame#WorkspaceToolbar {
    background-color: #FBFBFC;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#WorkspaceCanvasCard {
    background-color: #FBFBFC;
    border: none;
}

QLabel#WorkspacePanelTitle,
QLabel#WorkspaceDialogTitle {
    color: #18181B;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}

QLabel#WorkspacePanelHint {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QLabel#WorkspacePaletteCategory {
    color: #52525B;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    background: transparent;
    padding: 8px 2px 2px 2px;
}

QLabel#WorkspaceShortcutHint {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QLabel#WorkspaceSelectionMetrics {
    background-color: #18181B;
    color: #FFFFFF;
    border-radius: 7px;
    padding: 4px 9px;
    font-size: 11px;
    font-weight: 700;
}

QFrame#WorkspacePaletteButton,
QWidget#WorkspacePaletteButton {
    background-color: #FAFAFA;
    border: 1px solid #C7C7CF;
    border-radius: 17px;
}

QFrame#WorkspaceListItemCard,
QWidget#WorkspaceListItemCard {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#WorkspacePaletteButton:hover,
QWidget#WorkspacePaletteButton:hover {
    background-color: #FFFFFF;
    border-color: #A1A1AA;
}

QFrame#WorkspaceListItemCard:hover,
QWidget#WorkspaceListItemCard:hover {
    background-color: #F8FAFC;
    border-color: #C9D7F2;
}

QLabel#WorkspacePaletteTitle {
    color: #18181B;
    font-size: 12px;
    font-weight: 400;
    background: transparent;
}

QFrame#WorkspacePaletteButton:hover QLabel#WorkspacePaletteTitle,
QWidget#WorkspacePaletteButton:hover QLabel#WorkspacePaletteTitle {
    font-weight: 700;
}

QFrame#WorkspacePaletteAddButton {
    background-color: transparent;
    border: none;
    border-radius: 7px;
}

QFrame#WorkspacePaletteAddButton:hover {
    background-color: #F4F4F5;
    border: 1px solid #E4E4E7;
}

QFrame#WorkspacePaletteAddButton:pressed {
    background-color: #ECECEF;
    border: 1px solid #DADADF;
}

QFrame#WorkspaceLayoutTile,
QWidget#WorkspaceLayoutTile {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#WorkspaceLayoutTile QFrame#FluentCard,
QFrame#WorkspaceLayoutTile QWidget#FluentCard,
QFrame#WorkspaceLayoutTile QFrame#WorkspaceTileLivePreview,
QFrame#WorkspaceLayoutTile QWidget#WorkspaceTileLivePreview {
    border: none;
    background-color: #FFFFFF;
}

QLabel#WorkspaceTileSizeChip {
    background-color: #F4F4F5;
    color: #52525B;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    padding: 2px 8px;
    font-weight: 700;
}

QLabel#WorkspaceTilePreviewStrong,
QLabel#WorkspaceTilePreviewLine {
    background-color: #FFFFFF;
    color: #52525B;
    border: 1px solid #ECECEC;
    border-radius: 6px;
    padding: 3px 7px;
}

QMenu#WorkspaceTileContextMenu {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #DADADF;
    border-radius: 7px;
    padding: 6px;
}

QMenu#WorkspaceTileContextMenu::item {
    padding: 7px 28px 7px 12px;
    border-radius: 6px;
    min-width: 140px;
}

QMenu#WorkspaceTileContextMenu::item:selected {
    background-color: #F4F4F5;
    color: #18181B;
}

QMenu#WorkspaceTileContextMenu::item:disabled {
    color: #A1A1AA;
}

QListWidget#WorkspaceSwapBlockList {
    background-color: #FFFFFF;
    color: #18181B;
    border: none;
    outline: none;
}

QListWidget#WorkspaceSwapBlockList::item {
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 6px;
}

QListWidget#WorkspaceSwapBlockList::item:hover,
QListWidget#WorkspaceSwapBlockList::item:selected {
    background-color: #F4F4F5;
    color: #18181B;
}

QLabel#WorkspaceTilePreviewStrong {
    color: #18181B;
    font-weight: 700;
}

QLabel#WorkspaceCanvasEmptyState {
    color: #71717A;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

