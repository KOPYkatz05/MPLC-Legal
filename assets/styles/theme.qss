/* ==========================================
   MISSION LEGAL TRACKER — THEME
   Clean white / off-white / gray palette
   ========================================== */


/* ==========================================
   BASE
   ========================================== */

QMainWindow {
    background-color: #F4F4F5;
}

/* Root containers get explicit backgrounds */
QMainWindow > QWidget,
QStackedWidget,
QStackedWidget > QWidget {
    background-color: #F4F4F5;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #18181B;
}

QWidget#MissionariesPage,
QWidget#CalendarPage,
QWidget#ReportsPage,
QWidget#SettingsPage,
QWidget#TrashPage,
QWidget#MissionaryDetailPage,
QWidget#DashboardContent,
QWidget#CentralWidget {
    background-color: #F4F4F5;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* ==========================================
   SIDEBAR
   ========================================== */

QFrame#FluentSidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E4E4E7;
}

QLabel#SidebarBrand {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    padding: 0px 8px 18px 8px;
    background: transparent;
}

QLabel#SidebarGroupLabel {
    color: #A1A1AA;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 14px 8px 4px 8px;
    background: transparent;
}

QPushButton#SidebarNavButton {
    background-color: transparent;
    color: #52525B;
    border: none;
    border-radius: 6px;
    padding: 0px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#SidebarNavButton:hover {
    background-color: #F4F4F5;
    color: #27272A;
}

QPushButton#SidebarNavButton:checked {
    background-color: #EFF6FF;
    color: #1D4ED8;
    font-weight: 700;
}

QListWidget#Sidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E4E4E7;
    padding: 10px 0px;
    outline: 0;
}

QListWidget#Sidebar::item {
    height: 38px;
    padding-left: 18px;
    border-radius: 6px;
    margin: 2px 10px;
    color: #52525B;
    font-size: 13px;
}

QListWidget#Sidebar::item:hover {
    background-color: #F4F4F5;
    color: #27272A;
}

QListWidget#Sidebar::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
    font-weight: 600;
}


/* ==========================================
   PAGE HEADER
   ========================================== */

QFrame#PageHeader {
    background-color: #FFFFFF;
    border-bottom: none;
}

QFrame#HeaderDivider {
    background-color: #E4E4E7;
    border: none;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #18181B;
    background: transparent;
}

QLabel#PageSubtitle {
    font-size: 12px;
    color: #71717A;
    background: transparent;
}


/* ==========================================
   FILTER BAR
   ========================================== */

QFrame#FilterBar {
    background-color: #FAFAFA;
}

QLineEdit#SearchInput {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 0px 12px;
    font-size: 13px;
    color: #18181B;
}

QLineEdit#SearchInput:focus {
    border-color: #3B82F6;
}

QComboBox#FilterCombo {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 0px 10px;
    font-size: 13px;
    color: #3F3F46;
    min-width: 180px;
}

QComboBox#FilterCombo:focus {
    border-color: #3B82F6;
}

QComboBox#FilterCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#FilterCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 4px;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    outline: 0;
}

QLabel#ResultLabel {
    color: #A1A1AA;
    font-size: 12px;
    background: transparent;
}


/* ==========================================
   MISSIONARIES TABLE
   ========================================== */

QTableWidget#MissionaryTable {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9FA;
    border: none;
    border-top: 1px solid #E4E4E7;
    gridline-color: transparent;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    font-size: 13px;
    color: #3F3F46;
    outline: 0;
}

QTableWidget#MissionaryTable::item {
    padding: 0px 12px;
    border-bottom: 1px solid #F4F4F5;
}

QTableWidget#MissionaryTable::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}

QHeaderView {
    background-color: #FAFAFA;
    border: none;
}

QHeaderView::section {
    background-color: #FAFAFA;
    color: #A1A1AA;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0px 12px;
    border: none;
    border-bottom: 1px solid #E4E4E7;
    height: 36px;
}

QHeaderView::section:hover {
    background-color: #F4F4F5;
    color: #71717A;
}


/* ==========================================
   DASHBOARD CONTENT
   ========================================== */

QWidget#DashboardContent {
    background-color: #F4F4F5;
}


/* ==========================================
   SECTION HEADER
   ========================================== */

QLabel#SectionHeader {
    font-size: 11px;
    font-weight: 600;
    color: #A1A1AA;
    letter-spacing: 1px;
    background: transparent;
}


/* ==========================================
   STAT CARD
   ========================================== */

QFrame#StatCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}

QLabel#StatCount {
    font-size: 36px;
    font-weight: 700;
    background: transparent;
}

QLabel#StatTitle {
    font-size: 12px;
    color: #71717A;
    font-weight: 400;
    background: transparent;
}

QLabel#StatSubtitle {
    font-size: 11px;
    color: #71717A;
    background: transparent;
}

/* ==========================================
   LIST CARD
   ========================================== */

QFrame#ListCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}

QFrame#FluentCard,
QWidget#FluentCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
}

QWidget#DialogBody,
QWidget#PageSurface,
QScrollArea#PageSurface {
    background-color: #F4F4F5;
}

QCheckBox#DialogBody {
    background-color: #F4F4F5;
    padding: 8px 24px;
}

QLabel#BodyText {
    color: #18181B;
    font-size: 13px;
    background: transparent;
}

QLabel#StrongText {
    color: #18181B;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#MutedText {
    color: #71717A;
    font-size: 12px;
    background: transparent;
}

QLabel#SubtleText {
    color: #A1A1AA;
    font-size: 12px;
    background: transparent;
}

QLabel#MiniMutedText {
    color: #A1A1AA;
    font-size: 11px;
    background: transparent;
}

QLabel#PanelTitle {
    color: #18181B;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#StageFromLabel {
    color: #3B82F6;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#StageToLabel {
    color: #059669;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#FlowArrow {
    color: #A1A1AA;
    font-size: 18px;
    background: transparent;
}

QLabel#ReportSectionTitle {
    color: #18181B;
    font-size: 16px;
    font-weight: 700;
    padding-top: 8px;
    background: transparent;
}

QLabel#StageBadge {
    background-color: #EFF6FF;
    color: #1D4ED8;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 10px;
    border: 1px solid #BFDBFE;
}

QLabel#WarningIcon {
    color: #D97706;
    font-size: 16px;
    background: transparent;
}

QLabel#SuccessIcon {
    color: #059669;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QLabel#StatusSuccess,
QLabel#StatusDanger {
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}

QLabel#StatusSuccess {
    color: #059669;
}

QLabel#StatusDanger,
QLabel#DangerText {
    color: #DC2626;
    background: transparent;
}

QLabel#DangerText {
    font-size: 13px;
}

QLabel#WarningBadge {
    background-color: #FEF3C7;
    color: #92400E;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 10px;
    border: 1px solid #FCD34D;
}

QFrame#WarningBanner {
    background-color: #FEF3C7;
    border: 1px solid #FCD34D;
    border-radius: 8px;
}

QLabel#WarningBannerText {
    color: #92400E;
    font-size: 12px;
    background: transparent;
}

QLabel#OcrStatusBanner {
    background-color: #F4F4F5;
    padding: 10px;
    border-radius: 6px;
    font-weight: 600;
}

QLabel#OcrStatusBanner[status="success"] {
    color: #059669;
}

QLabel#OcrStatusBanner[status="partial"] {
    color: #D97706;
}

QLabel#OcrStatusBanner[status="failed"] {
    color: #DC2626;
}

QLabel#OcrStatusBanner[status="skipped"] {
    color: #71717A;
}

QFrame#SuccessBanner {
    background-color: #DCFCE7;
    border-bottom: 1px solid #86EFAC;
}

QLabel#SuccessBannerText {
    color: #166534;
    font-size: 13px;
    background: transparent;
}

QProgressBar#DialogProgressBar {
    border: none;
    background: #E4E4E7;
}

QProgressBar#DialogProgressBar::chunk {
    background-color: #3B82F6;
}

QFrame#ContentLoadingOverlay {
    background: transparent;
}

QLabel#ContentLoadingOverlayBlur {
    background: transparent;
}

QWidget#ContentLoadingOverlayScrim {
    background: rgba(248, 250, 252, 0.46);
}

QFrame#ContentLoadingOverlayPanel {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 16px;
    min-width: 300px;
    max-width: 360px;
}

QLabel#ContentLoadingOverlayTitle {
    color: #0F172A;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}

QLabel#ContentLoadingOverlaySubtitle {
    color: #64748B;
    font-size: 13px;
    background: transparent;
}

QTextEdit#NotesEditor,
QTextEdit#DocumentNotesEditor,
QPlainTextEdit#DocumentNotesEditor {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 8px;
    padding: 12px;
    font-size: 13px;
    color: #18181B;
}

QTextEdit#NotesEditor:focus,
QTextEdit#DocumentNotesEditor:focus,
QPlainTextEdit#DocumentNotesEditor:focus {
    border-color: #3B82F6;
}

QListWidget#TimelineList {
    background-color: transparent;
    border: none;
}

QListWidget#TimelineList::item {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 6px;
}

QFrame#UrgencyBar {
    border-radius: 2px;
}

QFrame#UrgencyBar[urgency="danger"] {
    background-color: #DC2626;
}

QFrame#UrgencyBar[urgency="warning"] {
    background-color: #EA580C;
}

QFrame#UrgencyBar[urgency="caution"] {
    background-color: #D97706;
}

QFrame#UrgencyBar[urgency="success"] {
    background-color: #059669;
}

QLabel#AlertBadge {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 10px;
}

QLabel#AlertBadge[tone="danger"] {
    background-color: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FECACA;
}

QLabel#AlertBadge[tone="warning"] {
    background-color: #FFF7ED;
    color: #9A3412;
    border: 1px solid #FED7AA;
}

QLabel#AlertBadge[tone="caution"] {
    background-color: #FEF3C7;
    color: #92400E;
    border: 1px solid #FCD34D;
}


/* ==========================================
   EXPIRATION ALERT DIALOG
   ========================================== */

QDialog#ExpirationAlertSurface,
QWidget#ExpirationAlertSurface {
    background: transparent;
}

QWidget#ExpirationAlertSurface QFrame#PageHeader,
QDialog#ExpirationAlertSurface QFrame#PageHeader {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 18px;
}

QWidget#ExpirationAlertSurface QLabel#PageTitle,
QDialog#ExpirationAlertSurface QLabel#PageTitle {
    color: #0F172A;
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QWidget#ExpirationAlertSurface QLabel#PageSubtitle,
QWidget#ExpirationAlertSurface QLabel#SubtleText,
QWidget#ExpirationAlertSurface QLabel#MutedText,
QDialog#ExpirationAlertSurface QLabel#PageSubtitle,
QDialog#ExpirationAlertSurface QLabel#SubtleText,
QDialog#ExpirationAlertSurface QLabel#MutedText {
    color: #64748B;
    font-size: 12px;
}

QWidget#ExpirationAlertSurface QLabel#StrongText,
QDialog#ExpirationAlertSurface QLabel#StrongText {
    color: #0F172A;
    font-size: 13px;
    font-weight: 650;
}

QWidget#ExpirationAlertSurface QLabel#WarningIcon,
QDialog#ExpirationAlertSurface QLabel#WarningIcon {
    color: #F59E0B;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
}

QWidget#ExpirationAlertSurface QLabel#WarningBadge,
QDialog#ExpirationAlertSurface QLabel#WarningBadge {
    color: #7C2D12;
    background: rgba(245, 158, 11, 0.16);
    border: 1px solid rgba(245, 158, 11, 0.26);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
    min-height: 18px;
}

QWidget#ExpirationAlertSurface QLabel#AlertBadge,
QDialog#ExpirationAlertSurface QLabel#AlertBadge {
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
    min-height: 18px;
}

QWidget#ExpirationAlertSurface QLabel#AlertBadge[tone="danger"],
QWidget#ExpirationAlertSurface QLabel#WarningBadge[tone="danger"],
QDialog#ExpirationAlertSurface QLabel#AlertBadge[tone="danger"],
QDialog#ExpirationAlertSurface QLabel#WarningBadge[tone="danger"] {
    color: #7F1D1D;
    background: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(239, 68, 68, 0.30);
}

QWidget#ExpirationAlertSurface QLabel#AlertBadge[tone="warning"],
QWidget#ExpirationAlertSurface QLabel#WarningBadge[tone="warning"],
QDialog#ExpirationAlertSurface QLabel#AlertBadge[tone="warning"],
QDialog#ExpirationAlertSurface QLabel#WarningBadge[tone="warning"] {
    color: #7C2D12;
    background: rgba(245, 158, 11, 0.16);
    border: 1px solid rgba(245, 158, 11, 0.30);
}

QWidget#ExpirationAlertSurface QLabel#AlertBadge[tone="caution"],
QWidget#ExpirationAlertSurface QLabel#WarningBadge[tone="caution"],
QDialog#ExpirationAlertSurface QLabel#AlertBadge[tone="caution"],
QDialog#ExpirationAlertSurface QLabel#WarningBadge[tone="caution"] {
    color: #92400E;
    background: rgba(251, 191, 36, 0.16);
    border: 1px solid rgba(251, 191, 36, 0.28);
}

QWidget#ExpirationAlertSurface QLabel#AlertBadge[tone="success"],
QWidget#ExpirationAlertSurface QLabel#WarningBadge[tone="success"],
QDialog#ExpirationAlertSurface QLabel#AlertBadge[tone="success"],
QDialog#ExpirationAlertSurface QLabel#WarningBadge[tone="success"] {
    color: #14532D;
    background: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(34, 197, 94, 0.24);
}

QWidget#ExpirationAlertSurface QFrame#FluentCard,
QDialog#ExpirationAlertSurface QFrame#FluentCard {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 18px;
}

QWidget#ExpirationAlertSurface QFrame#FluentCard:hover,
QDialog#ExpirationAlertSurface QFrame#FluentCard:hover {
    border-color: rgba(148, 163, 184, 0.24);
    background: rgba(255, 255, 255, 0.98);
}

QWidget#ExpirationAlertSurface QFrame#UrgencyBar,
QDialog#ExpirationAlertSurface QFrame#UrgencyBar {
    border-radius: 2px;
    min-width: 4px;
}

QWidget#ExpirationAlertSurface QFrame#UrgencyBar[urgency="danger"],
QDialog#ExpirationAlertSurface QFrame#UrgencyBar[urgency="danger"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #F97316,
        stop: 1 #EF4444
    );
}

QWidget#ExpirationAlertSurface QFrame#UrgencyBar[urgency="warning"],
QDialog#ExpirationAlertSurface QFrame#UrgencyBar[urgency="warning"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #FBBF24,
        stop: 1 #F59E0B
    );
}

QWidget#ExpirationAlertSurface QFrame#UrgencyBar[urgency="caution"],
QDialog#ExpirationAlertSurface QFrame#UrgencyBar[urgency="caution"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #FDE68A,
        stop: 1 #F59E0B
    );
}

QWidget#ExpirationAlertSurface QFrame#UrgencyBar[urgency="success"],
QDialog#ExpirationAlertSurface QFrame#UrgencyBar[urgency="success"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #86EFAC,
        stop: 1 #22C55E
    );
}

QWidget#ExpirationAlertSurface QScrollArea,
QDialog#ExpirationAlertSurface QScrollArea {
    border: none;
    background: transparent;
}

QWidget#ExpirationAlertSurface QScrollArea > QWidget > QWidget,
QDialog#ExpirationAlertSurface QScrollArea > QWidget > QWidget {
    background: transparent;
}


/* ==========================================
   COLUMN HEADERS
   ========================================== */

QFrame#ColumnHeaderRow {
    background-color: #FAFAFA;
    border-bottom: 1px solid #E4E4E7;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QLabel#ColHeaderLabel {
    font-size: 11px;
    font-weight: 600;
    color: #A1A1AA;
    letter-spacing: 0.5px;
    background: transparent;
}


/* ==========================================
   TABLE ROWS
   ========================================== */

QFrame#TableRow {
    background-color: #FFFFFF;
    border-bottom: 1px solid #F4F4F5;
}

QFrame#TableRowAlt {
    background-color: #FAFAFA;
    border-bottom: 1px solid #F4F4F5;
}

QLabel#RowText {
    font-size: 13px;
    color: #3F3F46;
    background: transparent;
}

QLabel#EmptyLabel {
    font-size: 13px;
    color: #A1A1AA;
    padding: 16px 4px;
    background: transparent;
}


/* ==========================================
   BUTTONS
   ========================================== */

QPushButton {
    background-color: #FFFFFF;
    color: #3F3F46;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #F4F4F5;
    border-color: #A1A1AA;
}

QPushButton:pressed {
    background-color: #E4E4E7;
}

QPushButton#PrimaryButton,
QPushButton[text="+ Add Missionary"],
QPushButton[text="Upload Document"],
QPushButton[text="Save"],
QPushButton[text="Save Extracted Data"],
QPushButton[text="Continue to Document Editor"] {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    font-weight: 500;
}

QPushButton#PrimaryButton:hover,
QPushButton[text="+ Add Missionary"]:hover,
QPushButton[text="Upload Document"]:hover,
QPushButton[text="Save"]:hover,
QPushButton[text="Save Extracted Data"]:hover,
QPushButton[text="Continue to Document Editor"]:hover {
    background-color: #1D4ED8;
}

QPushButton#SecondaryButton,
QPushButton#RefreshButton {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #BFDBFE;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
}

QPushButton#SecondaryButton:hover,
QPushButton#RefreshButton:hover {
    background-color: #EFF6FF;
}

QPushButton#SubtleButton {
    background-color: transparent;
    color: #52525B;
    border: 1px solid transparent;
}

QPushButton#SubtleButton:hover {
    background-color: #F4F4F5;
    border-color: #E4E4E7;
}

QPushButton#SuccessButton {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#SuccessButton:hover {
    background-color: #047857;
}

QPushButton#AdvanceButton {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 0px 16px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#AdvanceButton:hover {
    background-color: #047857;
}

QPushButton#DangerButton,
QPushButton[text="Delete Missionary"] {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
}

QPushButton#DangerButton:hover,
QPushButton[text="Delete Missionary"]:hover {
    background-color: #FEF2F2;
}

QFrame#DialogFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #E4E4E7;
}

QFrame#AddMissionarySurface QFrame#DialogFooter {
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

QPushButton[text="Cancel"],
QPushButton[text="Skip (no OCR data)"] {
    background-color: #FFFFFF;
    color: #71717A;
    border: 1px solid #E4E4E7;
}

QPushButton[text="Cancel"]:hover,
QPushButton[text="Skip (no OCR data)"]:hover {
    background-color: #F4F4F5;
}


/* ==========================================
   WORKFLOW / DOCUMENT LISTS
   ========================================== */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    outline: 0;
    padding: 2px;
}

QListWidget::item {
    height: 34px;
    padding-left: 10px;
    border-radius: 4px;
    color: #3F3F46;
    border-bottom: 1px solid #F4F4F5;
}

QListWidget::item:hover {
    background-color: #F4F4F5;
}

QListWidget::item:selected {
    background-color: #EFF6FF;
    color: #1D4ED8;
}


/* ==========================================
   TABS
   ========================================== */

QTabWidget::pane {
    border: 1px solid #E4E4E7;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget > QWidget {
    background-color: #FFFFFF;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #71717A;
    padding: 8px 20px;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #3B82F6;
    border-bottom: 2px solid #3B82F6;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: #27272A;
    background-color: #F4F4F5;
    border-radius: 6px 6px 0 0;
}


/* ==========================================
   FORM LABELS & LAYOUT
   ========================================== */

QLabel {
    background: transparent;
    color: #3F3F46;
}

QFormLayout QLabel {
    color: #71717A;
    font-size: 12px;
}


/* ==========================================
   INPUTS
   ========================================== */

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #3B82F6;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
    min-width: 140px;
}

QComboBox:focus {
    border-color: #3B82F6;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QAbstractSpinBox,
QDateEdit,
QDateTimeEdit,
QTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
}

QAbstractSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QTimeEdit:focus {
    border-color: #3B82F6;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button,
QDateEdit::up-button,
QDateEdit::down-button,
QDateTimeEdit::up-button,
QDateTimeEdit::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    width: 24px;
    background: transparent;
}

QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    width: 10px;
    height: 10px;
}

QCalendarWidget {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #D4D4D8;
    border-radius: 8px;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #EFF6FF;
    selection-color: #1D4ED8;
    outline: 0;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #18181B;
    border: none;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
}


/* ==========================================
   DIALOGS
   ========================================== */

QDialog {
    background-color: #FFFFFF;
}

QDialog QWidget {
    background-color: transparent;
}

QDialog QLabel {
    background: transparent;
}

QFrame#AddMissionarySurface {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 20px;
}

QFrame#AddMissionaryHeader {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #F8FAFC,
        stop: 1 #F1F5F9
    );
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom: 1px solid #E2E8F0;
}

QWidget#AddMissionaryBody {
    background-color: #FFFFFF;
}

QLabel#AddMissionaryFieldLabel {
    color: #27272A;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2px;
}

QLabel#AddMissionaryHint {
    color: #71717A;
    font-size: 11px;
}

QLineEdit#AddMissionaryInput {
    min-height: 38px;
    border-radius: 10px;
    padding: 8px 12px;
    border: 1px solid #CBD5E1;
}

QLineEdit#AddMissionaryInput:focus {
    border-color: #2563EB;
}

QPushButton#AddMissionaryDatePicker,
QDateEdit#AddMissionaryDatePicker {
    min-height: 38px;
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 8px 12px;
    text-align: left;
}

QPushButton#AddMissionaryDatePicker:hover,
QDateEdit#AddMissionaryDatePicker:hover {
    border-color: #94A3B8;
    background-color: #F8FAFC;
}

QPushButton#AddMissionaryDatePicker:focus,
QDateEdit#AddMissionaryDatePicker:focus {
    border-color: #2563EB;
}


/* ==========================================
   SLIDERS (Document Editor)
   ========================================== */

QSlider::groove:horizontal {
    height: 4px;
    background: #E4E4E7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #3B82F6;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::sub-page:horizontal {
    background: #BFDBFE;
    border-radius: 2px;
}


/* ==========================================
   MESSAGE BOX
   ========================================== */

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    background: transparent;
    color: #18181B;
}

QMessageBox QPushButton {
    min-width: 80px;
}


/* ==========================================
   UPLOAD WORKSPACE
   ========================================== */

QDialog#UploadWorkspaceDialog {
    background: transparent;
}

QLabel#UploadBackdrop {
    border: none;
    background: transparent;
}

QWidget#UploadBackdropScrim {
    background: rgba(15, 23, 42, 0.22);
}

QWidget#UploadWorkspaceSurface,
QDialog#UploadWorkspaceSurface {
    background-color: #FFFFFF;
    border-radius: 24px;
}

QWidget#UploadWorkspaceSurface QSplitter::handle,
QDialog#UploadWorkspaceSurface QSplitter::handle {
    background: transparent;
}

QWidget#UploadWorkspaceSurface QFrame#UploadSurfaceCard,
QDialog#UploadWorkspaceSurface QFrame#UploadSurfaceCard,
QWidget#UploadWorkspaceSurface QWidget#UploadSurfaceCard,
QDialog#UploadWorkspaceSurface QWidget#UploadSurfaceCard {
    background: #FFFFFF;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 18px;
}

QWidget#UploadWorkspaceSurface QFrame#UploadSurfaceCard:hover,
QDialog#UploadWorkspaceSurface QFrame#UploadSurfaceCard:hover,
QWidget#UploadWorkspaceSurface QWidget#UploadSurfaceCard:hover,
QDialog#UploadWorkspaceSurface QWidget#UploadSurfaceCard:hover {
    border-color: rgba(148, 163, 184, 0.24);
    background: #FFFFFF;
}

QWidget#UploadWorkspaceSurface QFrame#UploadPreviewToolbar,
QDialog#UploadWorkspaceSurface QFrame#UploadPreviewToolbar {
    background: rgba(248, 250, 252, 0.96);
    border: 1px solid rgba(226, 232, 240, 0.95);
    border-radius: 16px;
}

QWidget#UploadWorkspaceSurface QFrame#PageHeader,
QDialog#UploadWorkspaceSurface QFrame#PageHeader {
    background: #FFFFFF;
    border-top: 1px solid rgba(148, 163, 184, 0.12);
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

QFrame#UploadDropZone {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(248, 250, 252, 0.96),
        stop: 1 rgba(255, 255, 255, 0.96)
    );
    border: 2px dashed #CBD5E1;
    border-radius: 18px;
}

QLabel#UploadDropIcon {
    color: #2563EB;
    font-size: 24px;
    font-weight: 700;
}

QLabel#UploadDropTitle {
    color: #0F172A;
    font-size: 16px;
    font-weight: 650;
}

QListWidget#UploadQueueList {
    background: transparent;
    border: none;
    outline: 0;
    padding: 0px;
}

QListWidget#UploadQueueList::item {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

QFrame#UploadQueueItemCard {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(226, 232, 240, 0.98);
    border-radius: 12px;
}

QFrame#UploadQueueItemCard[selected="true"] {
    border: 1px solid rgba(96, 165, 250, 0.95);
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(239, 246, 255, 0.96),
        stop: 1 rgba(255, 255, 255, 0.98)
    );
}

QLabel#UploadFileIcon {
    background: rgba(37, 99, 235, 0.10);
    color: #1D4ED8;
    border: 1px solid rgba(37, 99, 235, 0.14);
    border-radius: 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#UploadQueueTitle {
    color: #0F172A;
    font-size: 13px;
    font-weight: 650;
    background: transparent;
}

QLabel#UploadQueueMeta {
    color: #64748B;
    font-size: 12px;
    background: transparent;
}

QLabel#UploadOcrFieldLabel {
    color: #334155;
    font-size: 12px;
    font-weight: 650;
    background: transparent;
}

QLabel#UploadStatusChip {
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #475569;
}

QLabel#UploadStatusChip[status="pending"] {
    color: #1D4ED8;
    background: rgba(37, 99, 235, 0.10);
    border: 1px solid rgba(37, 99, 235, 0.18);
}

QLabel#UploadStatusChip[status="ocr"] {
    color: #7C3AED;
    background: rgba(124, 58, 237, 0.10);
    border: 1px solid rgba(124, 58, 237, 0.18);
}

QLabel#UploadStatusChip[status="ready"] {
    color: #166534;
    background: rgba(34, 197, 94, 0.12);
    border: 1px solid rgba(34, 197, 94, 0.22);
}

QLabel#UploadStatusChip[status="review"] {
    color: #9A3412;
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.22);
}

QLabel#UploadStatusChip[status="saved"] {
    color: #14532D;
    background: rgba(22, 163, 74, 0.14);
    border: 1px solid rgba(22, 163, 74, 0.24);
}

QLabel#UploadStatusChip[status="failed"] {
    color: #991B1B;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.22);
}

QLabel#UploadStatusChip[status="skipped"] {
    color: #854D0E;
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.22);
}

QLabel#UploadZoomBadge {
    color: #475569;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 6px 10px;
    min-width: 76px;
    font-size: 11px;
    font-weight: 600;
}

QComboBox#UploadPageInput {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 30px;
    min-width: 152px;
}

QComboBox#UploadPageInput:focus {
    border-color: #2563EB;
}

QGraphicsView#UploadPreviewCanvas {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
}

QPushButton#UploadNavButton {
    background: #FFFFFF;
    color: #475569;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 0px 10px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#UploadNavButton:hover {
    background: #F8FAFC;
    border-color: #CBD5E1;
}

QPushButton#UploadNavButton:pressed {
    background: #EEF2F7;
}

QPushButton#UploadNavButton:disabled {
    color: #CBD5E1;
    background: #F8FAFC;
    border-color: #E2E8F0;
}

QLabel#UploadEmptyState {
    color: #94A3B8;
    font-size: 13px;
    font-weight: 600;
    padding: 18px;
    background: transparent;
}

QLabel#UploadReadValue {
    color: #0F172A;
    font-size: 13px;
    font-weight: 650;
    padding: 7px 10px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}

QComboBox#UploadFieldInput {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 10px;
    padding: 7px 10px;
    min-height: 22px;
}

QComboBox#UploadFieldInput:focus {
    border-color: #2563EB;
}

QScrollArea#UploadDetailsScroll {
    background: transparent;
    border: none;
}

QFrame#UploadProgressStep {
    background: transparent;
}

QWidget#UploadWorkspaceSurface QLabel#PageTitle,
QDialog#UploadWorkspaceSurface QLabel#PageTitle {
    color: #0F172A;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.2px;
}

QWidget#UploadWorkspaceSurface QLabel#PageSubtitle,
QWidget#UploadWorkspaceSurface QLabel#SubtleText,
QWidget#UploadWorkspaceSurface QLabel#MutedText,
QDialog#UploadWorkspaceSurface QLabel#PageSubtitle,
QDialog#UploadWorkspaceSurface QLabel#SubtleText,
QDialog#UploadWorkspaceSurface QLabel#MutedText {
    color: #64748B;
}

QWidget#UploadWorkspaceSurface QLabel#StrongText,
QDialog#UploadWorkspaceSurface QLabel#StrongText {
    color: #0F172A;
    font-weight: 650;
}

QLabel#UploadStepBadge {
    color: #1E293B;
    background: #E2E8F0;
    border-radius: 14px;
    font-size: 12px;
    font-weight: 800;
}

QFrame#UploadProgressStep[state="active"] QLabel#UploadStepBadge {
    background: #2563EB;
    color: #FFFFFF;
}

QFrame#UploadProgressStep[state="active"] QLabel#StrongText {
    color: #1D4ED8;
}

QFrame#UploadProgressStep[state="complete"] QLabel#UploadStepBadge {
    background: #16A34A;
    color: #FFFFFF;
}

QFrame#UploadProgressStep[state="idle"] QLabel#UploadStepBadge {
    background: #E2E8F0;
    color: #1E293B;
}
