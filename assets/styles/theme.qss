QFrame#TrashTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QLabel#TrashTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#TrashSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QFrame#TrashWorkspace {
    background-color: #FFFFFF;
}

QTableWidget#TrashTable {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
