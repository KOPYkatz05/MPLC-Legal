}

QWidget#WorkspacePropertiesPopup,
QDialog#WorkspacePropertiesDialog {
    background-color: transparent;
}

QFrame#WorkspacePropertiesSurface {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#WorkspacePropertiesHeader {
    background-color: #FFFFFF;
    border: none;
}

QFrame#WorkspacePropertiesBody {
    background-color: #FFFFFF;
}

QLabel#WorkspacePropertiesTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#WorkspacePropertiesSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QFrame#WorkspacePropertiesFieldsPanel {
    background-color: transparent;
    border: none;
}

QFrame#WorkspacePropertiesSelectedFields {
    background-color: #FBFBFC;
    border: 1px solid #ECECEC;
    border-radius: 8px;
}

QFrame#WorkspaceFieldPill {
    background-color: #FAFAFA;
    border: 1px solid #C7C7CF;
    border-radius: 14px;
}

QFrame#WorkspaceFieldPill:hover {
    background-color: #FFFFFF;
    border-color: #A1A1AA;
}

QLabel#WorkspaceFieldPillText {
    color: #18181B;
    font-size: 11px;
    font-weight: 400;
    background: transparent;
}

QFrame#WorkspaceFieldPill:hover QLabel#WorkspaceFieldPillText {
    font-weight: 700;
}

QPushButton#WorkspaceFieldPillRemove {
    background-color: transparent;
    color: #71717A;
    border: none;
    border-radius: 0px;
    padding: 0px;
    margin: 0px;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
}

QPushButton#WorkspaceFieldPillRemove:hover {
    background-color: transparent;
    color: #18181B;
}

QListWidget#WorkspaceFieldOptionList,
QListWidget#WorkspacePropertiesLinksList,
QListWidget#WorkspacePropertiesActionsList {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #ECECEC;
    border-radius: 8px;
    outline: none;
}

QListWidget#WorkspaceFieldOptionList::item,
QListWidget#WorkspacePropertiesLinksList::item,
QListWidget#WorkspacePropertiesActionsList::item {
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 7px;
}

QListWidget#WorkspaceFieldOptionList::item:hover,
QListWidget#WorkspaceFieldOptionList::item:selected,
QListWidget#WorkspacePropertiesLinksList::item:hover,
QListWidget#WorkspacePropertiesLinksList::item:selected,
QListWidget#WorkspacePropertiesActionsList::item:hover,
QListWidget#WorkspacePropertiesActionsList::item:selected {
    background-color: #F4F4F5;
    color: #18181B;
}

QListWidget#WorkspaceFieldOptionList::item:disabled {
    color: #A1A1AA;
    background-color: #FAFAFA;
}

QLabel#WorkspacePropertiesNoFields {
    color: #71717A;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}

QPushButton#WorkspacePropertiesCancelButton,
QPushButton#WorkspacePropertiesApplyButton {
    min-width: 64px;
    padding: 0px 14px;
    border-radius: 17px;
    font-size: 12px;
    font-weight: 400;
    background-color: #FAFAFA;
    color: #18181B;
    border: 1px solid #C7C7CF;
}

QPushButton#WorkspacePropertiesCancelButton:hover,
QPushButton#WorkspacePropertiesApplyButton:hover {
    background-color: #FFFFFF;
    border-color: #A1A1AA;
    font-weight: 700;
}

QPushButton#WorkspacePropertiesCancelButton:pressed,
QPushButton#WorkspacePropertiesApplyButton:pressed {
    background-color: #ECECEF;
}

/* Keep reusable dialog child panels inside the rounded surface. */
QFrame#MissionariesDialogHeader {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

QFrame#MissionariesDialogFooter {
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

/* Standard Qt reusable dialog factory */
QFrame#AppDialogSurface {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 20px;
}

QFrame#AppDialogHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

QLabel#AppDialogTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
}

QLabel#AppDialogSubtitle {
    color: #71717A;
    font-size: 11px;
}

QWidget#AppDialogBody {
    background-color: #FFFFFF;
}

QFrame#AppDialogFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #ECECEC;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}
