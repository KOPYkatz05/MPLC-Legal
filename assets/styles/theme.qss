    color: #52525B;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 0px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#CalendarModeButton:hover {
    background-color: #F4F4F5;
    color: #27272A;
}

QPushButton#CalendarModeButton:checked {
    background-color: #F4F4F5;
    color: #18181B;
    border-color: #DADADF;
}

QFrame#CalendarToolbar,
QWidget#CalendarToolbar,
QFrame#HistoryFilterBar,
QWidget#HistoryFilterBar,
QFrame#CalendarOverdueStrip {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QPushButton#CalendarToolbarPillButton,
QPushButton#CalendarNavPillButton,
QPushButton#CalendarAddTaskButton {
    border-radius: 15px;
    padding: 0px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#CalendarNavPillButton {
    padding: 0px;
    font-size: 16px;
    font-weight: 700;
}

QPushButton#CalendarToolbarPillButton,
QPushButton#CalendarNavPillButton {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #E4E4E7;
}

QPushButton#CalendarToolbarPillButton:hover,
QPushButton#CalendarNavPillButton:hover {
    background-color: #F9F7F4;
    border-color: #DED8CF;
}

QPushButton#CalendarAddTaskButton {
    background-color: #0EA5AC;
    color: #FFFFFF;
    border: 1px solid #0EA5AC;
}

QPushButton#CalendarAddTaskButton:hover {
    background-color: #07919A;
    border-color: #07919A;
}

QFrame#CalendarGridCard,
QWidget#CalendarGridCard {
    background-color: #FBFBFC;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

/* ==========================================
   TRASH FIGMA SHELL
