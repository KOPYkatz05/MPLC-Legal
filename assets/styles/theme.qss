/* ==========================================
   MISSION LEGAL TRACKER — THEME
   Clean white / off-white / gray palette
   ========================================== */


/* ==========================================
   BASE
   ========================================== */

QMainWindow {
    background-color: #FFFFFF;
}

/* Root containers get explicit backgrounds */
QMainWindow > QWidget,
QStackedWidget,
QStackedWidget > QWidget {
    background-color: #FFFFFF;
}

QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #18181B;
}

QWidget#MissionariesPage,
QWidget#CalendarPage,
QWidget#OfficeWorkPage,
QWidget#ReportsPage,
QWidget#SettingsPage,
QWidget#TrashPage,
QWidget#MissionaryDetailPage,
QWidget#DashboardContent,
QWidget#CentralWidget {
    background-color: #FFFFFF;
}

/* Shared page tabs: based on the Missionaries tab rhythm. */
QFrame#UnifiedTabStrip {
    background-color: transparent;
    min-height: 30px;
    max-height: 30px;
    border-bottom: 1px solid #D9D9D9;
}

QPushButton#UnifiedTopTab {
    color: #707070;
    font-size: 12px;
    font-weight: 400;
    padding: 0px 9px 7px 9px;
    border: 0px;
    border-radius: 0px;
    background-color: transparent;
}

QPushButton#UnifiedTopTab:hover {
    color: #242424;
}

QPushButton#UnifiedTopTab:checked,
QPushButton#UnifiedTopTab[active="true"] {
    color: #242424;
}

QFrame#UnifiedTabIndicator {
    background-color: #242424;
    border: none;
}

/* Missionaries page actions use the shared pill factory while retaining their
   established primary and secondary color treatments. */
QWidget#MissionariesPage QPushButton[missionariesTone] {
    min-height: 0px;
    max-height: 34px;
    border-radius: 17px;
    padding: 0px 12px;
    font-size: 13px;
    font-weight: 500;
}

QWidget#MissionariesPage QPushButton[missionariesTone="secondary"] {
    background-color: #FFFFFF;
    color: #0F5F64;
    border: 1px solid #9BE3E6;
}

QWidget#MissionariesPage QPushButton[missionariesTone="secondary"]:hover {
    background-color: #EFFCFC;
}

QWidget#MissionariesPage QPushButton[missionariesTone="primary"] {
    background-color: #0EA5AC;
    color: #FFFFFF;
    border: none;
}

QWidget#MissionariesPage QPushButton[missionariesTone="primary"]:hover {
    background-color: #0B9299;
}

QFrame#MissionariesTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QFrame#MissionariesTabStrip {
    background-color: transparent;
    min-height: 30px;
    max-height: 30px;
    border-bottom: 1px solid #D9D9D9;
}

QPushButton#MissionariesTopTab {
    color: #707070;
    font-size: 12px;
    font-weight: 400;
    padding: 0px 9px 7px 9px;
    border-bottom: 1px solid transparent;
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    border-radius: 0px;
    background-color: transparent;
}

QPushButton#MissionariesTopTab[active="true"] {
    color: #242424;
    border-bottom: 1px solid #242424;
}

QLabel#MissionariesTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#MissionariesSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QWidget#MissionariesWorkspace {
    background-color: #FFFFFF;
}

QFrame#MissionariesFilterBar,
QWidget#MissionariesFilterBar {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#MissionariesTableSurface {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#MissionariesTableHeader {
    background-color: #FBFBFC;
    border-bottom: 1px solid #ECECEC;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}

QWidget#AppDialogSurface QFrame#MissionariesDialogHeader,
QDialog#AppDialogSurface QFrame#MissionariesDialogHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

QWidget#AppDialogSurface QLabel#MissionariesDialogTitle,
QDialog#AppDialogSurface QLabel#MissionariesDialogTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QWidget#AppDialogSurface QLabel#MissionariesDialogSubtitle,
QDialog#AppDialogSurface QLabel#MissionariesDialogSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QWidget#AppDialogSurface QWidget#MissionariesDialogBody,
QDialog#AppDialogSurface QWidget#MissionariesDialogBody {
    background-color: #FFFFFF;
}

QWidget#AppDialogSurface QFrame#MissionariesDialogFooter,
QDialog#AppDialogSurface QFrame#MissionariesDialogFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #ECECEC;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

QWidget#AlertWorkspacePage,
QWidget#AlertWorkspaceContent,
QScrollArea#AlertWorkspaceScroll {
    background-color: #FFFFFF;
}

QFrame#AlertWorkspaceTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QFrame#AlertWorkspaceTabStrip {
    background-color: transparent;
    min-height: 30px;
    max-height: 30px;
    border-bottom: 1px solid #D9D9D9;
}

QLabel#AlertWorkspaceTopTab {
    color: #707070;
    font-size: 12px;
    font-weight: 400;
    padding: 0px 9px 7px 9px;
    border-bottom: 1px solid transparent;
}

QLabel#AlertWorkspaceTopTab[active="true"] {
    color: #242424;
    border-bottom: 1px solid #242424;
}

QLabel#AlertWorkspaceTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#AlertWorkspaceSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QFrame#AlertStepRow,
QFrame#AlertMissionaryRow {
    background-color: #FAFAFA;
    border: 1px solid #F1F1F1;
    border-radius: 7px;
}

QFrame#AlertStepRow:hover,
QFrame#AlertMissionaryRow:hover {
    background-color: #FFFFFF;
    border-color: #DADADF;
}

QLabel#AlertStepNumber {
    color: #0EA5AC;
    border: 1px solid #9BE3E6;
    border-radius: 7px;
    background-color: #EFFCFC;
    font-weight: 700;
}

QFrame#AlertFactTile {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#AlertWorkspaceErrorCard,
QWidget#AlertWorkspaceErrorCard {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QLabel#AlertFactValue {
    color: #18181B;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QLabel#AlertFactValue[tone="danger"] {
    color: #DC2626;
}

QLabel#AlertFactValue[tone="warning"] {
    color: #D97706;
}

QLabel#AlertFactValue[tone="info"] {
    color: #0EA5AC;
}

QLabel#AlertFactValue[tone="success"] {
    color: #059669;
}

QLabel#AlertFactValue[tone="neutral"] {
    color: #71717A;
}

QLabel#AlertWorkspaceChip {
    color: #71717A;
    border: 1px solid #71717A;
    border-radius: 7px;
    padding: 3px 8px;
    background-color: #FFFFFF;
    font-size: 11px;
    font-weight: 600;
}

QLabel#AlertWorkspaceChip[tone="danger"] {
    color: #DC2626;
    border-color: #DC2626;
}

QLabel#AlertWorkspaceChip[tone="warning"] {
    color: #D97706;
    border-color: #D97706;
}

QLabel#AlertWorkspaceChip[tone="info"] {
    color: #0F5F64;
    border-color: #0EA5AC;
}

QLabel#AlertWorkspaceChip[tone="success"] {
    color: #059669;
    border-color: #059669;
}

QWidget#SettingsPage,
QWidget#SettingsWorkspace {
    background-color: #FFFFFF;
}

QLabel#SettingsTitle {
    color: #18181B;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#SettingsSubtitle {
    color: #71717A;
    font-size: 12px;
    background: transparent;
}

QWidget#MissionaryDetailPage QLabel#SectionHeader {
    font-size: 10px;
    font-weight: 700;
    color: #A1A1AA;
    letter-spacing: 1.1px;
}

QFrame#MissionaryDetailTopBar,
QWidget#MissionaryDetailTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QWidget#MissionaryDetailPage QLabel#MissionaryDetailTitle {
    color: #18181B;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QFrame#MissionaryDetailTopTabs {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
    min-height: 36px;
    max-height: 36px;
}

QPushButton#MissionaryDetailTopTab {
    background-color: transparent;
    color: #52525B;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0px;
    padding: 0px 2px 7px 2px;
    margin-right: 18px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#MissionaryDetailTopTab:hover {
    color: #18181B;
    border-bottom-color: #DADADF;
}

QPushButton#MissionaryDetailTopTab:checked,
QPushButton#MissionaryDetailTopTab[active="true"] {
    color: #18181B;
    border-bottom-color: #18181B;
}

QWidget#MissionaryDetailPage QLabel#BodyText,
QWidget#MissionaryDetailPage QLabel#ReadOnlyValue {
    color: #18181B;
    font-size: 13px;
}

QWidget#MissionaryDetailPage QLabel#ReadOnlyValue[state="empty"] {
    color: #A1A1AA;
    font-weight: 500;
}

QWidget#MissionaryDetailPage QLabel#SourceBadge {
    color: #0F5F64;
    background: rgba(14, 165, 172, 0.08);
    border: 1px solid rgba(14, 165, 172, 0.16);
    border-radius: 7px;
    padding: 1px 6px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2px;
    min-height: 14px;
}

QWidget#MissionaryDetailPage QLabel#SourceBadge[source_kind="auto"] {
    color: #0F5F64;
    background: rgba(14, 165, 172, 0.08);
    border: 1px solid rgba(14, 165, 172, 0.16);
}

QWidget#MissionaryDetailPage QLabel#SummaryBadge {
    color: #52525B;
    background: #F4F4F5;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    padding: 3px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1px;
    min-height: 16px;
}

QWidget#MissionaryDetailPage QLabel#SummaryBadge[tone="primary"] {
    color: #0F5F64;
    background: rgba(14, 165, 172, 0.08);
    border-color: rgba(14, 165, 172, 0.16);
}

QWidget#MissionaryDetailPage QLabel#SummaryBadge[tone="subtle"] {
    color: #52525B;
    background: #F4F4F5;
    border-color: #E4E4E7;
}

QWidget#MissionaryDetailPage QDateEdit#MissionaryDetailDatePicker,
QWidget#MissionaryDetailPage QDateTimeEdit#MissionaryDetailDatePicker,
QWidget#MissionaryDetailPage QPushButton#MissionaryDetailDatePicker {
    min-height: 34px;
}

QWidget#MissionaryDetailPage QDateEdit#MissionaryDetailDatePicker[state="empty"],
QWidget#MissionaryDetailPage QDateTimeEdit#MissionaryDetailDatePicker[state="empty"] {
    color: transparent;
    background-color: #FBFBFC;
}

QWidget#MissionaryDetailPage QDateEdit#MissionaryDetailDatePicker[state="empty"] QLineEdit,
QWidget#MissionaryDetailPage QDateTimeEdit#MissionaryDetailDatePicker[state="empty"] QLineEdit {
    color: transparent;
    selection-color: transparent;
    selection-background-color: transparent;
}

QWidget#MissionaryDetailPage QLabel#DateEmptyOverlay {
    color: #A1A1AA;
    font-size: 12px;
    font-style: italic;
    padding-left: 8px;
    padding-right: 8px;
    background: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}


/* ==========================================
   SIDEBAR
   ========================================== */

QFrame#AppTitleBar {
    background-color: #FBFBFC;
    border: none;
    border-bottom: 1px solid #ECECEC;
}

QWidget#AppShellBody {
    background-color: #FFFFFF;
}

QFrame#AppTitleDragRegion,
QLabel#AppTitleDragAffordance {
    background-color: transparent;
    border: none;
}

QLabel#AppTitleDragAffordance {
    color: #A1A1AA;
    font-size: 11px;
}

QToolButton#AppWindowControlButton,
QToolButton#AppWindowCloseButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0px;
    margin: 2px 1px;
}

QToolButton#AppWindowControlButton:hover {
    background-color: #F4F4F5;
    border-color: #F4F4F5;
}

QToolButton#AppWindowCloseButton:hover {
    background-color: #FEE2E2;
    border-color: #FEE2E2;
}

QFrame#FluentSidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #D9D9D9;
}

QLabel#SidebarBrand {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    padding: 0px 8px 18px 8px;
    background: transparent;
}

QLabel#SidebarGroupLabel {
    color: #A1A1AA;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 14px 8px 4px 8px;
    background: transparent;
}

QPushButton#SidebarNavButton {
    background-color: transparent;
    color: #52525B;
    border: none;
    border-radius: 6px;
    padding: 0px 12px;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#SidebarNavButton:hover {
    background-color: #F4F4F5;
    color: #27272A;
}

QPushButton#SidebarNavButton:checked {
    background-color: #EFFCFC;
    color: #0F5F64;
    font-weight: 700;
}

QFrame#SidebarSeparator {
    background-color: transparent;
    border: none;
    border-top: 1px solid #D9D9D9;
    margin: 8px 16px;
}

QToolButton#SidebarMenuButton,
QToolButton#SidebarNavButton {
    background-color: transparent;
    color: #242424;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 0px;
    margin: 0px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}

QToolButton#SidebarMenuButton[sidebarExpanded="true"],
QToolButton#SidebarNavButton[sidebarExpanded="true"] {
    padding-left: 17px;
}

QToolButton#SidebarMenuButton:hover,
QToolButton#SidebarNavButton:hover {
    background-color: #F4F4F5;
}

QToolButton#SidebarNavButton:checked {
    background-color: #F1F1F6;
    border-color: #F1F1F6;
    color: #111111;
}

QListWidget#Sidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E4E4E7;
    padding: 10px 0px;
    outline: 0;
}

QListWidget#Sidebar::item {
    height: 38px;
    padding-left: 18px;
    border-radius: 6px;
    margin: 2px 10px;
    color: #52525B;
    font-size: 13px;
}

QListWidget#Sidebar::item:hover {
    background-color: #F4F4F5;
    color: #27272A;
}

QListWidget#Sidebar::item:selected {
    background-color: #EFFCFC;
    color: #0F5F64;
    font-weight: 600;
}


/* ==========================================
   PAGE HEADER
   ========================================== */

QFrame#PageHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QFrame#HeaderDivider {
    background-color: #ECECEC;
    border: none;
}

QLabel#PageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #18181B;
    background: transparent;
}

QLabel#PageSubtitle {
    font-size: 12px;
    color: #71717A;
    background: transparent;
}


/* ==========================================
   FILTER BAR
   ========================================== */

QFrame#FilterBar {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QComboBox#FilterCombo {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 7px;
    padding: 0px 10px;
    font-size: 13px;
    color: #3F3F46;
    min-width: 180px;
}

QComboBox#FilterCombo:focus {
    border-color: #18181B;
}

QComboBox#FilterCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#FilterCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 7px;
    selection-background-color: #F4F4F5;
    selection-color: #18181B;
    outline: 0;
}

QLabel#ResultLabel {
    color: #A1A1AA;
    font-size: 12px;
    background: transparent;
}


/* ==========================================
   MISSIONARIES TABLE
   ========================================== */

QTableWidget#MissionaryTable,
QTableView#MissionaryTable {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9FA;
    border: none;
    border-top: 1px solid #ECECEC;
    gridline-color: transparent;
    selection-background-color: #F4F4F5;
    selection-color: #18181B;
    font-size: 13px;
    color: #3F3F46;
    outline: 0;
}

QTableWidget#MissionaryTable::item,
QTableView#MissionaryTable::item {
    padding: 0px 12px;
    border-bottom: 1px solid #F1F1F1;
}

QTableWidget#MissionaryTable::item:selected,
QTableView#MissionaryTable::item:selected {
    background-color: #F4F4F5;
    color: #18181B;
}

QPushButton#MissionaryCellCopyButton {
    background-color: transparent;
    color: #71717A;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 3px;
}

QPushButton#MissionaryCellCopyButton:hover {
    background-color: #F4F4F5;
    border-color: #DADADF;
    color: #18181B;
}

QWidget#AppDialogSurface QListWidget#MissionaryColumnList,
QDialog#AppDialogSurface QListWidget#MissionaryColumnList {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
    outline: 0;
    padding: 6px;
}

QWidget#AppDialogSurface QListWidget#MissionaryColumnList::item,
QDialog#AppDialogSurface QListWidget#MissionaryColumnList::item {
    min-height: 30px;
    padding: 4px 8px;
    border-radius: 6px;
}

QWidget#AppDialogSurface QListWidget#MissionaryColumnList::item:selected,
QDialog#AppDialogSurface QListWidget#MissionaryColumnList::item:selected {
    background-color: #F4F4F5;
    color: #18181B;
}

QHeaderView {
    background-color: #FFFFFF;
    border: none;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #71717A;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0px 12px;
    border: none;
    border-bottom: 1px solid #ECECEC;
    height: 36px;
}

QHeaderView::section:hover {
    background-color: #FAFAFA;
    color: #18181B;
}


/* ==========================================
   DASHBOARD CONTENT
   ========================================== */

QFrame#DashboardTopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #ECECEC;
}

QFrame#DashboardTabStrip {
    background-color: transparent;
    min-height: 30px;
    max-height: 30px;
    border-bottom: 1px solid #D9D9D9;
}

QLabel#DashboardTopTab {
    color: #707070;
    font-size: 12px;
    font-weight: 400;
    padding: 0px 9px 7px 9px;
    border-bottom: 1px solid transparent;
}

QLabel#DashboardTopTab[active="true"] {
    color: #242424;
    border-bottom: 1px solid #242424;
}

QLabel#DashboardTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#DashboardSubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QWidget#DashboardContent {
    background-color: #FFFFFF;
}

QWidget#DashboardWorkspace,
QWidget#DashboardPrimaryColumn,
QWidget#DashboardSideColumn,
QWidget#DashboardStatGrid {
    background-color: transparent;
}

QWidget#DashboardPage QPushButton[dashboardTone] {
    min-height: 28px;
    border-radius: 14px;
    padding: 0px 14px;
    font-size: 11px;
    font-weight: 600;
}

QWidget#DashboardPage QPushButton[dashboardTone="secondary"] {
    color: #18181B;
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
}

QWidget#DashboardPage QPushButton[dashboardTone="secondary"]:hover {
    background-color: #F9F7F4;
    border-color: #C9C5BF;
}

QWidget#DashboardPage QPushButton[dashboardTone="subtle"] {
    color: #0F5F64;
    background-color: #F3FAF9;
    border: 1px solid #CBE9E5;
}

QWidget#DashboardPage QPushButton[dashboardTone="subtle"]:hover {
    color: #0B4F53;
    background-color: #E6F7F5;
    border-color: #99DDD5;
}

QWidget#DashboardPage QPushButton[dashboardTone="primary"] {
    color: #FFFFFF;
    background-color: #0EA5AC;
    border: 1px solid #0EA5AC;
}

QWidget#DashboardPage QPushButton[dashboardTone="primary"]:hover {
    background-color: #07919A;
    border-color: #07919A;
}

QWidget#DashboardPage QPushButton[dashboardTone="success"] {
    color: #047857;
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
}

QWidget#DashboardPage QPushButton[dashboardTone="success"]:hover {
    background-color: #D1FAE5;
    border-color: #6EE7B7;
}

QWidget#DashboardPage QPushButton[dashboardTone="danger"] {
    color: #B91C1C;
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
}

QWidget#DashboardPage QPushButton[dashboardTone="danger"]:hover {
    background-color: #FEE2E2;
    border-color: #FCA5A5;
}

QWidget#DashboardFocusMetrics,
QWidget#DashboardMiddleRow,
QWidget#DashboardExceptionsRow {
    background-color: transparent;
}

QFrame#DashboardFocusMetric,
QWidget#DashboardFocusMetric,
QFrame#DashboardPrioritiesCard,
QWidget#DashboardPrioritiesCard,
QFrame#DashboardUpcomingCard,
QWidget#DashboardUpcomingCard,
QFrame#DashboardBriefingCard,
QWidget#DashboardBriefingCard,
QFrame#DashboardResidencyCard,
QWidget#DashboardResidencyCard,
QFrame#DashboardCancelacionesCard,
QWidget#DashboardCancelacionesCard,
QFrame#DashboardExceptionCard,
QWidget#DashboardExceptionCard {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
