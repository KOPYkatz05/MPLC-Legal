    border-radius: 15px;
}

QFrame#CalendarTaskChip[done="true"] QLabel#PillActionLabel {
    color: #71717A;
}

QMenu#CalendarDaySummaryMenu {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #DADADF;
    border-radius: 7px;
    padding: 6px;
}

QMenu#CalendarDaySummaryMenu::item {
    background-color: transparent;
    padding: 0px;
    margin: 0px;
}

QMenu#CalendarDaySummaryMenu::item:selected {
    background-color: transparent;
}

QWidget#CalendarDaySummaryPanel,
QWidget#CalendarDaySummaryHeader,
QWidget#CalendarDaySummaryFooter,
QWidget#CalendarDaySummaryScroll,
QWidget#CalendarDaySummaryScroll QWidget#DialogBody {
    background-color: #FFFFFF;
}

QWidget#CalendarDaySummaryFooter {
    border-top: 1px solid #ECECEC;
}

QPushButton#CalendarDayCloseButton,
QPushButton#CalendarDayAddTaskButton {
    border-radius: 15px;
    padding: 0px 16px;
    font-weight: 500;
}

QPushButton#CalendarDayCloseButton {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #E4E4E7;
}

QPushButton#CalendarDayCloseButton:hover {
    background-color: #F9F7F4;
    border-color: #DED8CF;
}

QPushButton#CalendarDayAddTaskButton {
    background-color: #0EA5AC;
    color: #FFFFFF;
    border: 1px solid #0EA5AC;
}

QPushButton#CalendarDayAddTaskButton:hover {
    background-color: #07919A;
    border-color: #07919A;
}

QFrame#PillActionAccent {
    border-radius: 4px;
}

QLabel#PillActionLabel {
    color: #1F2937;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

QLabel#PillActionSubtitle {
    color: #6B7280;
    font-size: 11px;
    background: transparent;
}

QToolButton#PillActionIconButton {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-radius: 8px;
    padding: 0px;
    font-size: 12px;
    font-weight: 700;
}

QToolButton#PillActionIconButton:hover {
    background-color: #F1F5F9;
    color: #374151;
}

QToolButton#PillActionIconButton:pressed {
    background-color: #E5E7EB;
}

QFrame#OfficeWorkRow,
QWidget#OfficeWorkRow {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#OfficeWorkRow:hover,
QWidget#OfficeWorkRow:hover {
    background-color: #FBFBFC;
    border-color: #DADADF;
}

QFrame#OfficeWorkPriorityAccent {
    background-color: #71717A;
    border-radius: 2px;
}

QFrame#OfficeWorkPriorityAccent[tone="normal"] {
    background-color: #0EA5AC;
}

QFrame#OfficeWorkPriorityAccent[tone="important"] {
    background-color: #D97706;
}

QFrame#OfficeWorkPriorityAccent[tone="critical"] {
    background-color: #DC2626;
}

QFrame#OfficeWorkPriorityAccent[tone="group"] {
    background-color: #7A6EEC;
}

QFrame#OfficeWorkSectionHeader {
    background: transparent;
}

QLabel#OfficeWorkSectionTitle {
    color: #18181B;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}

QLabel#OfficeWorkSectionCount {
    color: #52525B;
    background-color: #F4F4F5;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    padding: 1px 7px;
    font-size: 11px;
    font-weight: 700;
}

QWidget#OfficeWorkSummaryRow {
    background: transparent;
}

QWidget#OfficeWorkTaskBoard {
    background: transparent;
}

QFrame#OfficeWorkTaskColumn {
    background-color: #FBFBFC;
    border: 1px solid #ECECEC;
    border-radius: 8px;
}

QFrame#OfficeWorkTaskColumn[dragOver="true"] {
    background-color: #FBFBFC;
    border-color: rgba(15, 23, 42, 0.12);
}

QFrame#OfficeWorkTaskDropIndicator {
    background-color: #F1F1F3;
    border: none;
    border-radius: 24px;
}

QLabel#OfficeWorkColumnEmpty {
    color: #A1A1AA;
    font-size: 12px;
    background: transparent;
    padding: 8px 4px;
}

QLabel#OfficeWorkFieldLabel {
    color: #3F3F46;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QLabel#OfficeWorkMeta {
    color: #71717A;
    font-size: 12px;
    background: transparent;
}


QFrame#CalendarSectionHeader {
    background: transparent;
}

QLabel#CalendarSectionTitle {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0px;
    background: transparent;
}

QLabel#CalendarSectionTitle[tone="danger"],
QLabel#CalendarSectionCount[tone="danger"],
QLabel#CalendarDueText[tone="danger"] {
    color: #DC2626;
}

QLabel#CalendarSectionTitle[tone="warning"],
QLabel#CalendarSectionCount[tone="warning"],
QLabel#CalendarDueText[tone="warning"] {
    color: #D97706;
}

QLabel#CalendarSectionTitle[tone="caution"],
QLabel#CalendarSectionCount[tone="caution"],
QLabel#CalendarDueText[tone="caution"] {
    color: #0EA5AC;
}

QLabel#CalendarSectionTitle[tone="success"],
QLabel#CalendarSectionCount[tone="success"],
QLabel#CalendarDueText[tone="success"] {
    color: #059669;
}

QLabel#CalendarSectionCount {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

QFrame#CalendarDayCard,
QWidget#CalendarDayCard {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
}

QFrame#CalendarDayHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #F4F4F5;
}

QFrame#CalendarAppointmentRow,
QFrame#CalendarAppointmentRowAlt {
    background-color: #FFFFFF;
    border: 1px solid #ECE7DF;
    border-radius: 25px;
}

QFrame#CalendarAppointmentRowAlt {
    background-color: #F9F7F4;
}

QFrame#CalendarTaskRow,
QFrame#CalendarTaskRowAlt {
    background-color: #FFFFFF;
    border: 1px solid #ECE7DF;
    border-radius: 25px;
}

QFrame#CalendarTaskRowAlt {
    background-color: #F9F7F4;
}

QFrame#CalendarTaskRow[done="true"],
QFrame#CalendarTaskRowAlt[done="true"] {
    background-color: #F4F4F5;
    border-color: #E4E4E7;
}

QFrame#CalendarAppointmentRow:hover,
QFrame#CalendarAppointmentRowAlt:hover,
QFrame#CalendarTaskRow:hover,
QFrame#CalendarTaskRowAlt:hover {
    background-color: #FFFFFF;
    border-color: #DED8CF;
}

QFrame#CalendarTaskRow[done="true"] QLabel#PillActionLabel,
QFrame#CalendarTaskRowAlt[done="true"] QLabel#PillActionLabel {
    color: #71717A;
}

QFrame#CalendarTypeBar {
    border-radius: 2px;
}

QLabel#CalendarDueText {
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}

/* ==========================================
   COLUMN HEADERS
   ========================================== */

QFrame#ColumnHeaderRow {
    background-color: #FAFAFA;
    border-bottom: 1px solid #E4E4E7;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QLabel#ColHeaderLabel {
    font-size: 11px;
    font-weight: 600;
    color: #A1A1AA;
    letter-spacing: 0.5px;
    background: transparent;
}


/* ==========================================
   TABLE ROWS
   ========================================== */

QFrame#TableRow {
    background-color: #FFFFFF;
    border-bottom: 1px solid #F4F4F5;
}

QFrame#TableRowAlt {
    background-color: #FAFAFA;
    border-bottom: 1px solid #F4F4F5;
}

QLabel#RowText {
    font-size: 13px;
    color: #3F3F46;
    background: transparent;
}

QLabel#EmptyLabel {
    font-size: 13px;
    color: #A1A1AA;
    padding: 16px 4px;
    background: transparent;
}


/* ==========================================
   BUTTONS
   ========================================== */

QPushButton {
    background-color: #FFFFFF;
    color: #3F3F46;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #F4F4F5;
    border-color: #A1A1AA;
}

QPushButton:pressed {
    background-color: #E4E4E7;
}

QPushButton#PrimaryButton,
QPushButton[text="+ Add Missionary"],
QPushButton[text="Upload Document"],
QPushButton[text="Save"],
QPushButton[text="Save Extracted Data"],
QPushButton[text="Continue to Document Editor"] {
    background-color: #0EA5AC;
    color: #FFFFFF;
    border: none;
    font-weight: 500;
}

QPushButton#PrimaryButton:hover,
QPushButton[text="+ Add Missionary"]:hover,
QPushButton[text="Upload Document"]:hover,
QPushButton[text="Save"]:hover,
QPushButton[text="Save Extracted Data"]:hover,
QPushButton[text="Continue to Document Editor"]:hover {
    background-color: #0B9299;
}

QPushButton#SecondaryButton,
QPushButton#RefreshButton {
    background-color: #FFFFFF;
    color: #0F5F64;
    border: 1px solid #9BE3E6;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
}

QPushButton#SecondaryButton:hover,
QPushButton#RefreshButton:hover {
    background-color: #EFFCFC;
}

QPushButton#SubtleButton {
    background-color: transparent;
    color: #52525B;
    border: 1px solid transparent;
}

QPushButton#SubtleButton:hover {
    background-color: #F4F4F5;
    border-color: #E4E4E7;
}

QPushButton#SuccessButton {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#SuccessButton:hover {
    background-color: #047857;
}

QPushButton#AdvanceButton {
    background-color: #059669;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 0px 16px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton#AdvanceButton:hover {
    background-color: #047857;
}

QPushButton#DangerButton,
QPushButton[text="Delete Missionary"] {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FECACA;
}

QPushButton#DangerButton:hover,
QPushButton[text="Delete Missionary"]:hover {
    background-color: #FEF2F2;
}

QFrame#DialogFooter {
    background-color: #F7F7F8;
    border-top: 1px solid #E4E4E7;
}

QFrame#AddMissionarySurface QFrame#DialogFooter {
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

QPushButton[text="Cancel"],
QPushButton[text="Skip (no OCR data)"] {
    background-color: #FFFFFF;
    color: #71717A;
    border: 1px solid #E4E4E7;
}

QPushButton[text="Cancel"]:hover,
QPushButton[text="Skip (no OCR data)"]:hover {
    background-color: #F4F4F5;
}


/* ==========================================
   WORKFLOW / DOCUMENT LISTS
   ========================================== */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    outline: 0;
    padding: 2px;
}

QListWidget::item {
    height: 34px;
    padding-left: 10px;
    border-radius: 4px;
    color: #3F3F46;
    border-bottom: 1px solid #F4F4F5;
}

QListWidget::item:hover {
    background-color: #F4F4F5;
}

QListWidget::item:selected {
    background-color: #EFFCFC;
    color: #0F5F64;
}


/* ==========================================
   TABS
   ========================================== */

QTabWidget::pane {
    border: 1px solid #E4E4E7;
    border-radius: 7px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget > QWidget {
    background-color: #FFFFFF;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: #71717A;
    padding: 8px 20px;
    font-size: 13px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
}

QTabBar::tab:selected {
    color: #0F5F64;
    border-bottom: 2px solid #0EA5AC;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: #27272A;
    background-color: #F4F4F5;
    border-radius: 6px 6px 0 0;
}

QTabWidget#SettingsTabs::pane {
    border: none;
    background-color: #FFFFFF;
    top: 0px;
}

QTabWidget#SettingsTabs > QWidget {
    background-color: #FFFFFF;
}

QTabWidget#SettingsTabs QTabBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #D9D9D9;
}

QTabWidget#SettingsTabs QTabBar::tab {
    background-color: transparent;
    color: #707070;
    min-height: 36px;
    padding: 0px 12px;
    margin: 0px 2px 0px 0px;
    border: none;
    border-bottom: 1px solid transparent;
    font-size: 15px;
    font-weight: 400;
}

QTabWidget#SettingsTabs QTabBar::tab:selected {
    color: #242424;
    background-color: #FFFFFF;
    border-bottom: 1px solid #242424;
    font-weight: 500;
}

QTabWidget#SettingsTabs QTabBar::tab:hover:!selected {
    color: #18181B;
    background-color: #FAFAFA;
    border-radius: 0px;
}

QWidget#SettingsTabPage {
    background-color: #FFFFFF;
}

QWidget#SettingsScrollShell {
    background-color: #FFFFFF;
}

QWidget#SettingsContent {
    background-color: #FFFFFF;
}

QWidget#SettingsColumn {
    background-color: transparent;
}

QFrame#SettingsCard {
    background-color: #FFFFFF;
    border: 1px solid #ECECEC;
    border-radius: 7px;
}

QFrame#SettingsCard:hover {
    border-color: #DADADF;
}

QLabel#SettingsCardTitle {
    color: #242424;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0px;
}

QLabel#SettingsCardHint,
QWidget#SettingsTabPage QLabel#MutedText {
    color: #616161;
    font-size: 12px;
}

QWidget#SettingsActionRow {
    background-color: transparent;
}

QWidget#SettingsTabPage QLineEdit,
QWidget#SettingsTabPage QComboBox,
QWidget#SettingsTabPage QDateEdit,
QWidget#SettingsTabPage QTimeEdit,
QWidget#SettingsTabPage QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D1D1;
    border-radius: 6px;
    min-height: 32px;
    padding: 0px 10px;
}

QWidget#SettingsTabPage QLineEdit:hover,
QWidget#SettingsTabPage QComboBox:hover,
QWidget#SettingsTabPage QDateEdit:hover,
QWidget#SettingsTabPage QTimeEdit:hover,
QWidget#SettingsTabPage QSpinBox:hover {
    border-color: #B3B3B3;
}

QWidget#SettingsTabPage QLineEdit:focus,
QWidget#SettingsTabPage QComboBox:focus,
QWidget#SettingsTabPage QDateEdit:focus,
QWidget#SettingsTabPage QTimeEdit:focus,
QWidget#SettingsTabPage QSpinBox:focus {
    border: 1px solid #0EA5AC;
}

QPushButton#SettingsHelpButton {
    background-color: #FFFFFF;
    color: #0F5F64;
    border: 1px solid #D1D1D1;
    border-radius: 7px;
    font-weight: 700;
    padding: 0px;
}

QPushButton#SettingsHelpButton:hover {
    background-color: #EFFCFC;
    border-color: #0EA5AC;
}


/* ==========================================
   FORM LABELS & LAYOUT
   ========================================== */

QLabel {
    background: transparent;
    color: #3F3F46;
}

QFormLayout QLabel {
    color: #71717A;
    font-size: 12px;
}


/* ==========================================
   INPUTS
   ========================================== */

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #0EA5AC;
}

/* Standard-Qt factory text inputs.  Their rounded surface is drawn by
   PixelCrispTextInputStyle so it remains clean at fractional DPI scales. */
QLineEdit[chatTextBox="true"],
QPlainTextEdit[chatTextBox="true"] {
    padding: 8px 13px;
    color: #18181B;
    font-size: 13px;
}

QLineEdit[chatTextBoxVariant="search"] {
    padding: 8px 32px 8px 13px;
}

QPlainTextEdit[chatTextBox="true"] {
    padding: 10px 13px;
}

QPlainTextEdit[chatTextBox="true"] QAbstractScrollArea::viewport {
    background: transparent;
    border: none;
}


QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
    min-width: 140px;
}

QComboBox:focus {
    border-color: #0EA5AC;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    selection-background-color: #EFFCFC;
    selection-color: #0F5F64;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

QAbstractSpinBox,
QDateEdit,
QDateTimeEdit,
QTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
    border-radius: 6px;
    padding: 6px 10px;
    color: #18181B;
    font-size: 13px;
    selection-background-color: #EFFCFC;
    selection-color: #0F5F64;
}

QAbstractSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus,
QTimeEdit:focus {
    border-color: #0EA5AC;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button,
QDateEdit::up-button,
QDateEdit::down-button,
QDateTimeEdit::up-button,
QDateTimeEdit::down-button,
QTimeEdit::up-button,
QTimeEdit::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    width: 24px;
    background: transparent;
}

QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    width: 10px;
    height: 10px;
}

QCalendarWidget {
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #D4D4D8;
    border-radius: 7px;
}

QCalendarWidget QWidget {
    background-color: #FFFFFF;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    selection-background-color: #EFFCFC;
    selection-color: #0F5F64;
    outline: 0;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #18181B;
    border: none;
    padding: 4px 8px;
    margin: 2px;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    border: 1px solid #D4D4D8;
}


/* ==========================================
   DIALOGS
   ========================================== */

QDialog {
    background-color: #FFFFFF;
}

QDialog#AppDialogShell {
    background: transparent;
}

QDialog QWidget {
    background-color: transparent;
}

QDialog QLabel {
    background: transparent;
}

QFrame#AddMissionarySurface {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 20px;
}

QFrame#AddMissionaryHeader {
    background-color: #FFFFFF;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom: 1px solid #ECECEC;
}

QLabel#AddMissionaryTitle {
    color: #18181B;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}

QLabel#AddMissionarySubtitle {
    color: #71717A;
    font-size: 11px;
    background: transparent;
}

QWidget#AddMissionaryBody {
    background-color: #FFFFFF;
}

QFrame#AddMissionaryFooter {
    background-color: #FFFFFF;
    border-top: 1px solid #ECECEC;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

QLabel#AddMissionaryFieldLabel {
    color: #18181B;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0px;
}

QLabel#AddMissionaryHint {
    color: #71717A;
    font-size: 11px;
}

QWidget#CountryCompletionRow {
    background-color: transparent;
}

QLabel#CountryCompletionCode {
    color: #18181B;
    font-size: 12px;
    font-weight: 700;
}

QLabel#CountryCompletionName {
    color: #71717A;
    font-size: 12px;
}

QLineEdit#AddMissionaryInput {
    min-height: 34px;
    border-radius: 7px;
    padding: 7px 10px;
    border: 1px solid #DADADF;
    background-color: #FFFFFF;
    color: #18181B;
}

QLineEdit#AddMissionaryInput:focus {
    border-color: #18181B;
}

QPushButton#AddMissionaryDatePicker,
QDateEdit#AddMissionaryDatePicker {
    min-height: 34px;
    background-color: #FFFFFF;
    color: #18181B;
    border: 1px solid #DADADF;
    border-radius: 7px;
    padding: 7px 10px;
    text-align: left;
}

QPushButton#AddMissionaryDatePicker:hover,
QDateEdit#AddMissionaryDatePicker:hover {
    border-color: #C8C8CF;
    background-color: #FBFBFC;
}

QPushButton#AddMissionaryDatePicker:focus,
QDateEdit#AddMissionaryDatePicker:focus {
    border-color: #18181B;
}


/* ==========================================
   SLIDERS (Document Editor)
   ========================================== */

QSlider::groove:horizontal {
    height: 4px;
    background: #E4E4E7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #0EA5AC;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #9BE3E6;
    border-radius: 2px;
}


/* ==========================================
   MESSAGE BOX
   ========================================== */

QMessageBox,
QMessageBox#AppMessageBox {
    background-color: #FFFFFF;
    border-radius: 7px;
}

QMessageBox QLabel,
QMessageBox#AppMessageBox QLabel {
    background: transparent;
    color: #18181B;
    font-size: 13px;
    padding: 2px 0px;
}

QMessageBox QPushButton,
QMessageBox#AppMessageBox QPushButton {
    min-width: 96px;
    min-height: 30px;
    border-radius: 5px;
}

QWidget#AppDialogSurface,
QDialog#AppDialogSurface {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 20px;
}

QWidget#UploadWorkspaceSurface,
QDialog#UploadWorkspaceSurface {
    background-color: #FFFFFF;
    border: 1px solid #DADADF;
    border-radius: 20px;
}

QWidget#UploadWorkspaceSurface QSplitter#UploadWorkspaceSplitter,
QDialog#UploadWorkspaceSurface QSplitter#UploadWorkspaceSplitter {
    background-color: #FFFFFF;
}

QWidget#UploadWorkspaceSurface QFrame#UploadSurfaceCard,
QDialog#UploadWorkspaceSurface QFrame#UploadSurfaceCard,
