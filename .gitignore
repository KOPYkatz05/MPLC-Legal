# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.db-wal
*.db-shm
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
/build/
/dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local app, IDE, and agent state
.agents/
.config/
.local/
.idea/
.vscode/

# Runtime output and temporary files
logs/
data/Backups/
*.log
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
test_output/
tmp*/
run_tmp/

# Test source belongs in version control. Generated test output remains covered
# by the cache/build/runtime rules above.

# OS-specific noise
.DS_Store
Thumbs.db
